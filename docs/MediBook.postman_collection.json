    {
      "name": "3. Booking",
      "item": [
        {
          "name": "Book (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/appointments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "appointments"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"patientId\": 4,\n  \"doctorId\": 3,\n  \"apptDatetime\": \"{{futureDay}} 10:00\"\n}"
            }
          }
        },
        {
          "name": "Book in the past (422)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/appointments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "appointments"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"patientId\": 4,\n  \"doctorId\": 3,\n  \"apptDatetime\": \"2020-01-01 10:00\"\n}"
            }
          }
        },
        {
          "name": "Book 09:15 (422 boundary)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/appointments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "appointments"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"patientId\": 4,\n  \"doctorId\": 3,\n  \"apptDatetime\": \"{{futureDay}} 09:15\"\n}"
            }
          }
        },
        {
          "name": "Book 17:00 (422 hours)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/appointments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "appointments"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"patientId\": 4,\n  \"doctorId\": 3,\n  \"apptDatetime\": \"{{futureDay}} 17:00\"\n}"
            }
          }
        },
        {
          "name": "Book malformed date (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/appointments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "appointments"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"patientId\": 4,\n  \"doctorId\": 3,\n  \"apptDatetime\": \"next tuesday\"\n}"
            }
          }
        },
        {
          "name": "Book taken slot (409 + waitlist offer)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/appointments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "appointments"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"patientId\": 4,\n  \"doctorId\": 1,\n  \"apptDatetime\": \"{{fullDay}} 09:00\"\n}"
            }
          }
        },
        {
          "name": "Book 12th slot on near-cap day (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/appointments",
