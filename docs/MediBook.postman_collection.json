{
  "info": {
    "name": "MediBook API",
    "description": "Set the collection variables first: fullDay = the seeded near-cap day (today + 4 days), tomorrow = tomorrow's date, futureDay = any free future date.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "fullDay",
      "value": "YYYY-MM-DD"
    },
    {
      "key": "tomorrow",
      "value": "YYYY-MM-DD"
    },
    {
      "key": "futureDay",
      "value": "YYYY-MM-DD"
    }
  ],
  "item": [
    {
      "name": "1. Patients",
      "item": [
