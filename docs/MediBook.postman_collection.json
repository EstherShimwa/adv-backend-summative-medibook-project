                "appointments"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"patientId\": 8,\n  \"doctorId\": 1,\n  \"apptDatetime\": \"{{fullDay}} 16:30\"\n}"
            }
          }
        },
        {
          "name": "Book 13th (409 day full)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/appointments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
