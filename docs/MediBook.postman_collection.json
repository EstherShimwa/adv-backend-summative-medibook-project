    {
      "name": "4. Waitlist",
      "item": [
        {
          "name": "Join waitlist",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/waitlist",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "waitlist"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"patientId\": 5,\n  \"doctorId\": 1,\n  \"date\": \"{{fullDay}}\",\n  \"preferredTime\": \"12:30\"\n}"
            }
          }
        },
        {
          "name": "View waitlist",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/waitlist?doctorId=1&date={{fullDay}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "waitlist"
              ],
              "query": [
                {
                  "key": "doctorId",
                  "value": "1"
                },
                {
                  "key": "date",
                  "value": "{{fullDay}}"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "5. Cancellation",
      "item": [
        {
          "name": "Cancel appointment 11 (>48h: 100%, frees a slot -> worker promotes waitlist)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/appointments/11",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "appointments",
                "11"
              ]
            }
          }
        },
        {
          "name": "Cancel again (409)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/appointments/11",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "appointments",
                "11"
              ]
            }
          }
        },
        {
          "name": "Book tomorrow 16:30 (then cancel it for 50% or 0%)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/appointments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "appointments"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"patientId\": 7,\n  \"doctorId\": 2,\n  \"apptDatetime\": \"{{tomorrow}} 16:30\"\n}"
            }
          }
        },
        {
          "name": "Cancel a past appointment (422)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/appointments/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "appointments",
                "1"
              ]
            }
          }
        }
      ]
